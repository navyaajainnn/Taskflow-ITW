# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET="replace_with_a_long_random_secret"

# How long a login token stays valid
JWT_EXPIRES_IN="1d"

# Port the API server listens on
PORT=5000
